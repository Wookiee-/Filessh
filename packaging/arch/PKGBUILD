pkgname=filessh-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Solar-PuTTY style tabbed SSH client for Linux with FileZilla import (Tauri build)'
arch=('x86_64')
url='https://github.com/Wookiee-/Filessh'
license=('custom')
depends=('gtk3' 'hicolor-icon-theme' 'libsoup3' 'openssl' 'webkit2gtk-4.1')
source=("Filessh_0.1.0_amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf "$srcdir/Filessh_0.1.0_amd64.deb" -C "$srcdir"
  bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"
}
