{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filessh",
  "version": "0.1.0",
  "identifier": "tech.wookiee.filessh",
  "build": {
    "frontendDist": "../renderer",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Filessh",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Network",
    "shortDescription": "Solar-PuTTY style tabbed SSH client for Linux with FileZilla import",
    "longDescription": "Tabbed GUI SSH client with FileZilla SFTP import."
  }
}
