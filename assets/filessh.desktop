[Desktop Entry]
Name=Filessh
Comment=Solar-PuTTY style tabbed SSH client with FileZilla import
Exec=sh -c "cd __REPO__ && npm start -- --ozone-platform-hint=auto"
Icon=__REPO__/assets/icon.png
Terminal=false
Type=Application
Categories=Network;RemoteAccess;
StartupWMClass=filessh
# Hidden from menus (the Flatpak is the visible entry); present only so
# dev windows (app-id / StartupWMClass `filessh`) resolve the right icon.
NoDisplay=true
