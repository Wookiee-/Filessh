{
  "name": "filessh",
  "version": "0.1.0",
  "description": "Solar-PuTTY style GUI SSH client for Linux with FileZilla SFTP import",
  "main": "main.js",
  "desktopName": "filessh",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --linux AppImage",
    "dist:dir": "electron-builder --linux --dir",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "tech.wookiee.filessh",
    "productName": "Filessh",
    "afterPack": "./scripts/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;RemoteAccess",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "description": "Solar-PuTTY style tabbed SSH client for Linux with FileZilla import"
    },
    "appImage": {
      "artifactName": "Filessh-${version}.AppImage"
    }
  }
}
